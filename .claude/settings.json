{
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(pnpm build)",
      "Bash(pnpm format)",
      "Bash(pnpm lint)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx eslint :*)",
      "Bash(npx prettier --write :*)",
      "Bash(npx prettier --check :*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(node -e:*)",
      "Edit(prd.json)",
      "Write(prd.json)",
      "Edit(agent-progress.txt)",
      "Write(agent-progress.txt)",
      "Bash(./ralph/ralph.sh :*)"
    ],
    "deny": [
      "Read(.env)",
      "Edit(.env)",
      "Write(.env)",
      "Edit(pnpm-lock.yaml)",
      "Write(pnpm-lock.yaml)",
      "Edit(.next/**)",
      "Write(.next/**)",
      "Edit(node_modules/**)",
      "Write(node_modules/**)",
      "Edit(.agents/**)",
      "Write(.agents/**)"
    ],
    "ask": [
      "Bash(pnpm dev)",
      "Bash(pnpm start)",
      "Bash(pnpm add :*)",
      "Bash(pnpm remove :*)",
      "Edit(eslint.config.mjs)",
      "Write(eslint.config.mjs)",
      "Edit(next.config.ts)",
      "Write(next.config.ts)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-files.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/verify.sh",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
