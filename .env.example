# Required. The app throws at startup if either is missing — src/config.ts
# validates them with Zod so a missing variable fails fast instead of surfacing
# later at a random API call.
NEXT_PUBLIC_URL = http://localhost:3000
NEXT_PUBLIC_API_ENDPOINT = http://localhost:4000

# Google sign-in. Commented out in src/config.ts as well — uncomment in both
# places together, otherwise startup validation fails.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID =
# NEXT_PUBLIC_GOOGLE_AUTHORIZED_REDIRECT_URI =
